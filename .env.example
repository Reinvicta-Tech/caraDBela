# Copia para .env e ajusta. Todos os valores são opcionais.
PORT=3000
# Usa 0.0.0.0 para aceder a partir de outros equipamentos da rede (e receber eventos do ESP32).
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/CaraDBela
# Se ficar vazio, é gerado e guardado em .dados/segredo-jwt
JWT_SECRET=
# true apenas quando servido por HTTPS
COOKIE_SECURE=false
# Número de proxies de confiança à frente da aplicação
TRUST_PROXY=0
# Permite que qualquer pessoa na rede crie conta
PERMITIR_REGISTO=false
# Minutos entre verificações automáticas da rede (0 desliga)
MONITOR_MINUTOS=0
# Rede a analisar, ex.: 192.168.1.0/24. Vazio = detetar
REDE=
FUSO_HORARIO=Europe/Lisbon
# O script "vulners" do nmap envia as versões dos serviços encontrados para vulners.com
NMAP_VULNERS=false
# Dias a guardar eventos
EVENTOS_DIAS=90
